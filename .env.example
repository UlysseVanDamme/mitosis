# Copy to .env (gitignored). start.sh fills MITOSIS_PASSCODES and MITOSIS_SECRET with random values if missing.

# LLM provider: fake | claude-cli (local `claude -p`, no key) | anthropic
MITOSIS_PROVIDER=claude-cli
# Only for MITOSIS_PROVIDER=anthropic. Never commit a real key.
ANTHROPIC_API_KEY=

# Demo logins, JSON {username: passcode} for desk (admin), jan (expert), sofie (consultant),
# vandessel (client HR admin), guest (public). Use long random values.
MITOSIS_PASSCODES=
# HMAC key for bearer tokens (>= 32 chars). Unset = random per process (tokens die on restart).
MITOSIS_SECRET=
# Token lifetime in seconds (default 8h)
MITOSIS_TOKEN_TTL=28800

# Comma-separated CORS allowlist (the Vite dev proxy needs none)
MITOSIS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Per-user requests per minute on /query, /baseline, /trust-check
MITOSIS_RATE_QUERY=30
# Max request body in bytes
MITOSIS_MAX_BODY=65536
# Set to 1 to expose /api/docs (OpenAPI) locally; off by default
MITOSIS_API_DOCS=0
